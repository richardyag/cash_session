<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_cash_session_handover" model="ir.actions.report">
        <field name="name">Minuta de rendición</field>
        <field name="model">cash.session</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">cash_session.report_handover</field>
        <field name="report_file">cash_session.report_handover</field>
        <field name="binding_model_id" ref="model_cash_session"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_handover_document">
        <t t-call="web.external_layout">
            <div class="page">
                <h2 class="mt-4">Minuta de rendición de caja</h2>
                <p class="text-muted">
                    Comprobante interno de entrega de fondos del responsable de
                    la caja al cajero central. No genera asientos contables
                    adicionales — los movimientos contables ya están registrados
                    en cada cobranza y en el asiento de transferencia de efectivo.
                </p>

                <div class="row mt-4 mb-4">
                    <div class="col-6">
                        <strong>Sesión:</strong> <span t-field="o.name"/><br/>
                        <strong>Caja:</strong> <span t-field="o.cash_register_id.name"/><br/>
                        <strong>Responsable saliente:</strong> <span t-field="o.responsible_id.name"/>
                    </div>
                    <div class="col-6">
                        <strong>Apertura:</strong> <span t-field="o.date_open"/><br/>
                        <strong>Cierre:</strong> <span t-field="o.date_close"/><br/>
                        <strong>Compañía:</strong> <span t-field="o.company_id.name"/>
                    </div>
                </div>

                <!-- Bloque efectivo -->
                <h4 class="mt-4">Efectivo</h4>
                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th>Diario</th>
                            <th class="text-end">Apertura</th>
                            <th class="text-end">Cobros</th>
                            <th class="text-end">Físico final</th>
                            <th class="text-end">Diferencia</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="o.closing_line_ids.filtered(lambda l: l.journal_id.cash_session_kind == 'cash')" t-as="cl">
                            <tr>
                                <td><span t-field="cl.journal_id.name"/></td>
                                <td class="text-end">
                                    <t t-set="opl" t-value="o.opening_line_ids.filtered(lambda l: l.journal_id == cl.journal_id)[:1]"/>
                                    <span t-out="opl.physical_amount or 0.0" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                </td>
                                <td class="text-end">
                                    <span t-out="cl.theoretical_amount - (opl.physical_amount or 0.0)" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                </td>
                                <td class="text-end">
                                    <span t-field="cl.physical_amount" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                </td>
                                <td class="text-end">
                                    <span t-field="cl.difference" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>
                <p>
                    <strong>Total efectivo entregado a Caja Central:</strong>
                    <span t-out="sum(o.closing_line_ids.filtered(lambda l: l.journal_id.cash_session_kind == 'cash').mapped('physical_amount'))"
                          t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                </p>

                <!-- Detalle de movimientos de efectivo (clasificado por concepto) -->
                <t t-set="cash_moves" t-value="o.get_cash_movements()"/>
                <h5 class="mt-3">Detalle de movimientos de efectivo</h5>
                <t t-if="cash_moves">
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>Concepto</th>
                                <th>Cliente / beneficiario</th>
                                <th>Comprobante / motivo</th>
                                <th class="text-center">Fecha</th>
                                <th class="text-end">Entrada</th>
                                <th class="text-end">Salida</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="cash_moves" t-as="m">
                                <tr>
                                    <td><span t-out="m['concept']"/></td>
                                    <td><span t-out="m['partner']"/></td>
                                    <td><span t-out="m['reference']"/></td>
                                    <td class="text-center"><span t-out="m['date'] and m['date'].strftime('%d/%m')"/></td>
                                    <td class="text-end">
                                        <t t-if="m['amount_in']">
                                            <span t-out="m['amount_in']" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </t>
                                    </td>
                                    <td class="text-end">
                                        <t t-if="m['amount_out']">
                                            <span t-out="m['amount_out']" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </t>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="4" class="text-end"><strong>Totales:</strong></td>
                                <td class="text-end">
                                    <strong>
                                        <span t-out="sum(m['amount_in'] for m in cash_moves)"
                                              t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                    </strong>
                                </td>
                                <td class="text-end">
                                    <strong>
                                        <span t-out="sum(m['amount_out'] for m in cash_moves)"
                                              t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                    </strong>
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                    <p class="text-muted" style="font-size: 0.9em;">
                        Cada línea indica el concepto: cobro de factura, transferencia
                        entre cajas, ingreso desde central, retiro, pago a proveedor, etc.
                        Entradas − salidas = variación del efectivo de la sesión.
                    </p>
                </t>
                <t t-else="">
                    <p class="text-muted">Sin movimientos de efectivo en esta sesión.</p>
                </t>

                <!-- Bloque cheques -->
                <h4 class="mt-4">Cheques de tercero recibidos</h4>
                <t t-if="o.handover_check_ids">
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>Diario</th>
                                <th>N° cheque</th>
                                <th>Banco</th>
                                <th>Librador</th>
                                <th>Cliente</th>
                                <th class="text-center">Fecha de pago</th>
                                <th class="text-end">Importe</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="o.handover_check_ids.sorted('payment_date')" t-as="ch">
                                <tr>
                                    <td><span t-field="ch.original_journal_id.name"/></td>
                                    <td><span t-field="ch.name"/></td>
                                    <td><span t-field="ch.bank_id.name"/></td>
                                    <td><span t-field="ch.issuer_vat"/></td>
                                    <td><span t-field="ch.partner_id.name"/></td>
                                    <td class="text-center"><span t-field="ch.payment_date"/></td>
                                    <td class="text-end">
                                        <span t-field="ch.amount" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="6" class="text-end"><strong>Total cheques:</strong></td>
                                <td class="text-end">
                                    <strong>
                                        <span t-field="o.handover_check_total" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                    </strong>
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                    <p class="text-muted" style="font-size: 0.9em;">
                        Los cheques se entregan físicamente al cajero central y quedan
                        en la cartera de la compañía (cuenta de Cheques de Terceros).
                        No se contabiliza un movimiento adicional por la rendición.
                    </p>
                </t>
                <t t-else="">
                    <p class="text-muted">Sin cheques recibidos en esta sesión.</p>
                </t>

                <!-- Bloque transferencias bancarias (informativo) -->
                <t t-if="o.transfer_payment_ids">
                    <h4 class="mt-4">Transferencias bancarias recibidas</h4>
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>Cliente</th>
                                <th>Diario</th>
                                <th>N° comprobante de transferencia</th>
                                <th class="text-center">Fecha</th>
                                <th class="text-end">Importe</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="o.transfer_payment_ids.sorted('date')" t-as="tp">
                                <tr>
                                    <td><span t-field="tp.partner_id.name"/></td>
                                    <td><span t-field="tp.journal_id.name"/></td>
                                    <td>
                                        <t t-if="tp.transfer_reference">
                                            <span t-field="tp.transfer_reference"/>
                                        </t>
                                        <t t-else="">
                                            <em class="text-muted">— sin nro de comprobante —</em>
                                        </t>
                                    </td>
                                    <td class="text-center"><span t-field="tp.date"/></td>
                                    <td class="text-end">
                                        <span t-field="tp.amount" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="4" class="text-end"><strong>Total transferencias:</strong></td>
                                <td class="text-end">
                                    <strong>
                                        <span t-field="o.handover_transfer_total" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                    </strong>
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                    <p class="text-muted" style="font-size: 0.9em;">
                        El N° de comprobante de transferencia (CoelSA o similar) lo
                        carga el cajero al registrar el pago, en el campo
                        "N° comprobante de transferencia" del recibo. No se confunde
                        con el N° de factura. Las transferencias no se rinden
                        físicamente — la plata cae directo en cuenta bancaria.
                    </p>
                </t>

                <!-- Bloque tarjetas (informativo) -->
                <t t-if="o.handover_card_total">
                    <h4 class="mt-4">Tarjetas (informativo)</h4>
                    <p>
                        Total cobrado con tarjetas:
                        <strong>
                            <span t-field="o.handover_card_total" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                        </strong>
                    </p>
                    <p class="text-muted" style="font-size: 0.9em;">
                        Las tarjetas no se rinden físicamente. Permanecen en sus
                        diarios hasta la acreditación bancaria.
                    </p>
                </t>

                <!-- Total general -->
                <div class="mt-4 p-3" style="background-color: #f5f0f8; border-radius: 6px;">
                    <h4>Total general entregado</h4>
                    <p class="mb-1">
                        Efectivo:
                        <span t-out="sum(o.closing_line_ids.filtered(lambda l: l.journal_id.cash_session_kind == 'cash').mapped('physical_amount'))"
                              t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                    </p>
                    <p class="mb-1">
                        Cheques:
                        <span t-field="o.handover_check_total" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                    </p>
                    <h5 class="mt-2">
                        Total:
                        <span t-out="sum(o.closing_line_ids.filtered(lambda l: l.journal_id.cash_session_kind == 'cash').mapped('physical_amount')) + o.handover_check_total"
                              t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                    </h5>
                </div>

                <!-- Observaciones -->
                <t t-if="o.closing_observations">
                    <h4 class="mt-4">Observaciones del cierre</h4>
                    <p t-field="o.closing_observations"/>
                </t>

                <!-- Firmas -->
                <div class="row mt-5">
                    <div class="col-6 text-center">
                        <div style="border-top: 1px solid #000; padding-top: 8px; margin-top: 60px;">
                            <strong>Entrega</strong><br/>
                            <span t-field="o.responsible_id.name"/>
                        </div>
                    </div>
                    <div class="col-6 text-center">
                        <div style="border-top: 1px solid #000; padding-top: 8px; margin-top: 60px;">
                            <strong>Recibe (Cajero Central)</strong><br/>
                            Aclaración:
                        </div>
                    </div>
                </div>

                <!-- ============================================ -->
                <!-- ANEXO — Facturas canceladas en la sesión     -->
                <!-- ============================================ -->
                <t t-if="o.paid_invoice_ids">
                    <p style="page-break-before: always;"/>
                    <h3 class="mt-4">Anexo — Facturas canceladas en esta sesión</h3>
                    <p class="text-muted" style="font-size: 0.9em;">
                        Detalle informativo de las facturas que fueron canceladas
                        (parcial o totalmente) con los pagos registrados durante
                        esta sesión de caja. Este anexo no se firma — es solo
                        para trazabilidad operativa del cajero.
                    </p>
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>N° factura</th>
                                <th>Cliente</th>
                                <th class="text-center">Fecha factura</th>
                                <th class="text-end">Total factura</th>
                                <th class="text-end">Saldo pendiente</th>
                                <th class="text-center">Estado</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="o.paid_invoice_ids" t-as="inv">
                                <tr>
                                    <td><span t-field="inv.name"/></td>
                                    <td><span t-field="inv.partner_id.name"/></td>
                                    <td class="text-center"><span t-field="inv.invoice_date"/></td>
                                    <td class="text-end">
                                        <span t-field="inv.amount_total" t-options='{"widget": "monetary", "display_currency": inv.currency_id}'/>
                                    </td>
                                    <td class="text-end">
                                        <span t-field="inv.amount_residual" t-options='{"widget": "monetary", "display_currency": inv.currency_id}'/>
                                    </td>
                                    <td class="text-center">
                                        <t t-if="inv.payment_state == 'paid'">
                                            <span style="color: #2e8b57;"><strong>Pagada</strong></span>
                                        </t>
                                        <t t-elif="inv.payment_state == 'partial'">
                                            <span style="color: #cc7700;">Parcial</span>
                                        </t>
                                        <t t-else="">
                                            <span t-field="inv.payment_state"/>
                                        </t>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="3" class="text-end"><strong>Total facturado impactado:</strong></td>
                                <td class="text-end">
                                    <strong>
                                        <span t-out="sum(o.paid_invoice_ids.mapped('amount_total'))"
                                              t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                    </strong>
                                </td>
                                <td class="text-end">
                                    <strong>
                                        <span t-out="sum(o.paid_invoice_ids.mapped('amount_residual'))"
                                              t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                    </strong>
                                </td>
                                <td/>
                            </tr>
                        </tfoot>
                    </table>
                </t>
            </div>
        </t>
    </template>

    <template id="report_handover">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="cash_session.report_handover_document"/>
            </t>
        </t>
    </template>

</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Redirige el botón "Pay" de account.move al flujo de Yagüven Payment Group
         (action_open_payment_group) en lugar del wizard nativo de Odoo.
         Hay dos botones con el mismo name pero diferente id:
           - account_invoice_payment_btn: cuando NO hay pagos pendientes de aplicar
           - account_invoice_payment_secondary_btn: cuando SÍ los hay
         Aplica para ambas compañías (S.A. y COMERCIAL). -->
    <record id="view_account_move_payment_group_btn" model="ir.ui.view">
        <field name="name">account.move.form.payment.group.btn</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@id='account_invoice_payment_btn']" position="attributes">
                <attribute name="name">action_open_payment_group</attribute>
            </xpath>
            <xpath expr="//button[@id='account_invoice_payment_secondary_btn']" position="attributes">
                <attribute name="name">action_open_payment_group</attribute>
            </xpath>
        </field>
    </record>

</odoo>

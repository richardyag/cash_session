<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- account.payment form: agregar N° comprobante de transferencia
         debajo del Memo, visible solo si el journal es de tipo bank
         configurado como transferencia. -->
    <record id="view_account_payment_form_inherit_cash_session" model="ir.ui.view">
        <field name="name">account.payment.form.cash.session</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='memo']" position="after">
                <field name="transfer_reference"
                       invisible="journal_id.cash_session_kind != 'bank'"
                       placeholder="Ej: CoelSA 1234567"/>
            </xpath>
        </field>
    </record>

    <!-- account.payment.register wizard: el wizard que se abre al pagar
         una factura. Acá es donde el cajero típicamente trabaja. -->
    <record id="view_account_payment_register_form_inherit_cash_session" model="ir.ui.view">
        <field name="name">account.payment.register.form.cash.session</field>
        <field name="model">account.payment.register</field>
        <field name="inherit_id" ref="account.view_account_payment_register_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='communication']" position="after">
                <field name="transfer_reference"
                       invisible="journal_id.cash_session_kind != 'bank'"
                       placeholder="Ej: CoelSA 1234567"
                       string="N° comprobante de transferencia"/>
                <field name="card_brand"
                       invisible="journal_id.cash_session_kind != 'card'"
                       string="Red de tarjeta"/>
            </xpath>
        </field>
    </record>

    <!-- account.payment form: mostrar red de tarjeta y N° comprobante -->
    <record id="view_account_payment_form_inherit_card_brand" model="ir.ui.view">
        <field name="name">account.payment.form.card.brand</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='memo']" position="after">
                <field name="card_brand"
                       invisible="journal_id.cash_session_kind != 'card'"
                       string="Red de tarjeta"/>
            </xpath>
        </field>
    </record>

</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- App raíz independiente (no dentro de Facturación) -->
    <!-- ============================================================ -->
    <menuitem id="menu_cash_session_root"
              name="Caja"
              web_icon="cash_session,static/description/icon.png"
              sequence="55"/>

    <!-- ============================================================ -->
    <!-- 1. Operación -->
    <!-- ============================================================ -->
    <menuitem id="menu_cash_session_sessions"
              name="Sesiones de caja"
              parent="menu_cash_session_root"
              action="action_cash_session"
              sequence="10"/>

    <menuitem id="menu_cash_withdrawal"
              name="Extracciones / retiros"
              parent="menu_cash_session_root"
              action="action_cash_withdrawal"
              groups="cash_session.group_cash_withdrawal"
              sequence="15"/>

    <menuitem id="menu_cash_register_main"
              name="Cajas físicas"
              parent="menu_cash_session_root"
              action="action_cash_register"
              sequence="20"/>

    <!-- ============================================================ -->
    <!-- 2. Ayuda -->
    <!-- ============================================================ -->
    <menuitem id="menu_cash_session_help_root"
              name="Ayuda"
              parent="menu_cash_session_root"
              sequence="80"/>

    <menuitem id="menu_cash_session_help_faq"
              name="Preguntas frecuentes"
              parent="menu_cash_session_help_root"
              action="action_cash_session_help_faq"
              sequence="10"/>

    <menuitem id="menu_cash_session_help_howto"
              name="Cómo funciona"
              parent="menu_cash_session_help_root"
              action="action_cash_session_help_howto"
              sequence="20"/>

    <!-- Configuración movida fuera porque "Cajas físicas" ya aparece como
         menú principal (menu_cash_register_main). Mantener ambos era
         redundante y confuso para el cajero. -->

</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_cash_session" model="ir.ui.view">
        <field name="name">res.config.settings.cash.session</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='bank_cash']" position="inside">
                <setting string="Cash Session" help="Cuenta de diferencias y caja central usadas al cerrar sesiones de caja.">
                    <div class="content-group">
                        <div class="row mt16">
                            <label for="cash_difference_account_id" class="col-3 o_light_label"/>
                            <field name="cash_difference_account_id"
                                   options="{'no_create': True}"/>
                        </div>
                        <div class="row mt8">
                            <label for="cash_difference_income_account_id" class="col-3 o_light_label"/>
                            <field name="cash_difference_income_account_id"
                                   options="{'no_create': True}"/>
                        </div>
                        <div class="row mt8">
                            <label for="cash_central_journal_id" class="col-3 o_light_label"/>
                            <field name="cash_central_journal_id"
                                   options="{'no_create': True}"/>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>

    <record id="res_config_settings_view_form_inherit_cash_session_company" model="ir.ui.view">
        <field name="name">res.config.settings.cash.session.company</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='company_id']" position="after">
                <field name="cash_difference_account_id" invisible="1"/>
                <field name="cash_difference_income_account_id" invisible="1"/>
                <field name="cash_central_journal_id" invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>
